<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_ux" model="ir.ui.view">
        <field name="name">product.template.form.ux</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="biotex_catalog.view_product_template_form_biotex"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='biotex']/group" position="before">
                <field name="ux_checklist" widget="biotex_checklist" nolabel="1"/>
            </xpath>
            <xpath expr="//page[@name='biotex']" position="after">
                <page string="Existencias por delegación" name="ux_stock" invisible="type != 'consu'">
                    <field name="ux_stock_matrix" widget="biotex_stock_matrix" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
